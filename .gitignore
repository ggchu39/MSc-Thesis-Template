# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
*.RData
.RDataTmp
.RDataTmp/

# User-specific files
.Ruserdata

# RStudio files
.Rproj.user/
*.Rproj

# OAuth2 token
.httr-oauth

# knitr / rmarkdown cache
*_cache/
cache/
*.utf8.md
*.knit.md

# Quarto
.quarto/
_freeze/
_site/

# Build/check artifacts
*-Ex.R
/*.tar.gz
/*.Rcheck/

# Vignettes (if any)
vignettes/*.html
vignettes/*.pdf

# Environment variables
.Renviron

# Outputs (template repos should not commit generated results)
analysis/_demo_outputs/**
!analysis/_demo_outputs/.gitkeep

# Saved objects (avoid leaking results)
*.rds
*.Rds

# OS junk
.DS_Store
Thumbs.db

# Misc
po/*~
rsconnect/

